{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wakeup",
  "main": "src/index.ts",
  "base_dir": "./",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "preview_urls": false,
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.css", "**/*.webmanifest", "**/web/*.js"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "AppObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppObject"] }]
}
